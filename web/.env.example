# Where the web app reads its data from.
#   static -> JSON files written by `uv run python -m api.export` into public/data/v1/ (default)
#   api    -> a running FastAPI server (`uv run uvicorn api.main:app`)
VITE_DATA_MODE=static
# Base URL. Leave empty to use public/data (static) or the dev proxy (api).
VITE_DATA_BASE=
# Raster basemap tiles for the map. Must allow your use; OSM's policy suits light demo use.
VITE_BASEMAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
